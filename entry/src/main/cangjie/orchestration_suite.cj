// ============================================================================
// Test class 12: Delegate wiring + currentStatus (GattServer & GattClient)
// ============================================================================

@Test
class DelegateAndStatusE2EUT {

    @TestCase
    func server_currentStatus_initialIsInitialized(): Unit {
        let server = MdocGattServer()
        @Expect(statusName(server.currentStatus()), "Initialized")
    }

    @TestCase
    func client_currentStatus_initialIsInitializing(): Unit {
        let client = MdocGattClient()
        @Expect(statusName(client.currentStatus()), "Initializing")
    }

    @TestCase
    func server_getDelegate_noneBeforeSet(): Unit {
        let server = MdocGattServer()
        @Expect(server.getDelegate().isNone(), true)
    }

    @TestCase
    func client_getDelegate_noneBeforeSet(): Unit {
        let client = MdocGattClient()
        @Expect(client.getDelegate().isNone(), true)
    }

    @TestCase
    func server_setDelegate_thenGetDelegateSome(): Unit {
        let server = MdocGattServer()
        let del = RecordingDelegate(Some(DeviceEngagementInfo("svc-uuid-1")))
        server.setDelegate(del)
        @Expect(server.getDelegate().isSome(), true)
    }

    @TestCase
    func client_setDelegate_thenGetDelegateSome(): Unit {
        let client = MdocGattClient()
        let del = RecordingDelegate(None)
        client.setDelegate(del)
        @Expect(client.getDelegate().isSome(), true)
    }

    @TestCase
    func server_setDelegate_engagementReadableThroughDelegate(): Unit {
        let server = MdocGattServer()
        let del = RecordingDelegate(Some(DeviceEngagementInfo("00000000-0000-0000-0000-0000000000AB")))
        server.setDelegate(del)
        let got = server.getDelegate()
        match (got) {
            case Some(d) =>
                let eng = d.deviceEngagement()
                match (eng) {
                    case Some(e) => @Expect(e.bleServiceUuid, "00000000-0000-0000-0000-0000000000AB")
                    case None => @Expect(false, true)
                }
            case None => @Expect(false, true)
        }
    }
}

// ============================================================================
// Test class 13: MdocOfflineDelegate concrete-impl callback semantics
// ============================================================================

@Test
class OfflineDelegateImplE2EUT {

    @TestCase
    func deviceEngagement_returnsConfiguredInfo(): Unit {
        let del = RecordingDelegate(Some(DeviceEngagementInfo("svc-9")))
        let eng = del.deviceEngagement()
        match (eng) {
            case Some(e) => @Expect(e.bleServiceUuid, "svc-9")
            case None => @Expect(false, true)
        }
    }

    @TestCase
    func deviceEngagement_noneWhenUnset(): Unit {
        let del = RecordingDelegate(None)
        @Expect(del.deviceEngagement().isNone(), true)
    }

    @TestCase
    func callbacks_recordState(): Unit {
        let del = RecordingDelegate(None)
        del.didPoweredOn(true)
        del.didConnected(true, Some("reader"))
        del.didChangeStatus(TransferStatus.Connected)
        let payload: Array<UInt8> = [0x83u8, 0x01u8]
        del.didReceiveRequest(payload)
        del.didFinishedWithError(ErrorCode.BleNoData, "no data")

        @Expect(del.poweredOnCalls, 1)
        @Expect(del.connectedCalls, 1)
        match (del.lastStatus) {
            case Some(s) => @Expect(statusName(s), "Connected")
            case None => @Expect(false, true)
        }
        match (del.lastReceived) {
            case Some(d) => @Expect(d.size, 2)
            case None => @Expect(false, true)
        }
        match (del.lastErrorCode) {
            case Some(c) => @Expect(c.describe(), "NO_DATA")
            case None => @Expect(false, true)
        }
    }
}

// ============================================================================
// Test class 14: holder status sequence through the loopback backend
// ============================================================================

@Test
class GattServerHolderSequenceE2EUT {

    @TestCase
    func advertising_emitsPoweredOnThenQrEngagementReady(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        @Expect(rig.status(), "QrEngagementReady")
        @Expect(rig.delegate.poweredOnCalls, 1)
        @Expect(rig.delegate.statusTrail(), "PoweredOn,QrEngagementReady")
        @Expect(rig.backend.isAdvertising(), true)
        @Expect(rig.server.isBlePoweredOn(), true)
        match (rig.backend.advertisedServiceUuid()) {
            case Some(u) => @Expect(u, RIG_SERVICE_UUID)
            case None => @Expect(false, true)
        }
    }

    @TestCase
    func advertising_twice_isIdempotent(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        rig.server.startBleAdvertising()
        @Expect(rig.delegate.poweredOnCalls, 1)
        @Expect(rig.delegate.statusTrail(), "PoweredOn,QrEngagementReady")
    }

    @TestCase
    func advertising_withoutEngagement_reportsDeviceEngagementMissing(): Unit {
        let backend = LoopbackPeripheralBackend()
        let server = MdocGattServer(backend: backend, pacing: NotifyPacing.immediate())
        let del = RecordingDelegate(None)
        server.setDelegate(del)
        server.startBleAdvertising()
        @Expect(statusName(server.currentStatus()), "Error")
        match (del.lastErrorCode) {
            case Some(c) => @Expect(c.describe(), "DEVICE_ENGAGEMENT_MISSING")
            case None => @Expect(false, true)
        }
        @Expect(backend.isOpen(), false)
    }

    @TestCase
    func connected_onlyAfterBothSubscriptions(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        let ev = rig.events()
        ev.onConnectionStateChanged(RIG_READER_ID, true)
        @Expect(rig.status(), "QrEngagementReady")
        ev.onWriteRequest(rig.cccd(ServiceCharacteristics.STATE_UUID, true))
        @Expect(rig.status(), "QrEngagementReady")
        @Expect(rig.delegate.connectedCalls, 0)
        ev.onWriteRequest(rig.cccd(ServiceCharacteristics.SERVER_2_CLIENT_UUID, true))
        @Expect(rig.status(), "Connected")
        @Expect(rig.delegate.connectedCalls, 1)
    }

    @TestCase
    func connected_subscriptionOrderDoesNotMatter(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        let ev = rig.events()
        ev.onConnectionStateChanged(RIG_READER_ID, true)
        ev.onWriteRequest(rig.cccd(ServiceCharacteristics.SERVER_2_CLIENT_UUID, true))
        @Expect(rig.status(), "QrEngagementReady")
        ev.onWriteRequest(rig.cccd(ServiceCharacteristics.STATE_UUID, true))
        @Expect(rig.status(), "Connected")
    }

    @TestCase
    func cccdWrite_isAcknowledgedWithSuccess(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        rig.events().onWriteRequest(rig.cccd(ServiceCharacteristics.STATE_UUID, true))
        let responses = rig.backend.responded()
        @Expect(responses.size, 1)
        @Expect(responses[0].status, AttStatus.SUCCESS)
    }

    @TestCase
    func startRequest_beforeCccdEvents_promotesToConnectedThenStarted(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        let ev = rig.events()
        ev.onConnectionStateChanged(RIG_READER_ID, true)
        ev.onWriteRequest(rig.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.START_REQUEST], 2))
        @Expect(rig.status(), "Started")
        @Expect(rig.delegate.connectedCalls, 1)
        @Expect(rig.delegate.statusTrail(), "PoweredOn,QrEngagementReady,Connected,Started")
    }

    @TestCase
    func fullHolderSequence_matchesIosOrder(): Unit {
        let rig = LoopbackRig()
        rig.start(185)
        @Expect(rig.status(), "Started")

        let request = Array<UInt8>(300, {i => UInt8((i + 7) % 256)})
        rig.writeRequest(request, 64)
        @Expect(rig.status(), "RequestReceived")
        match (rig.delegate.lastReceived) {
            case Some(r) => @Expect(bytesEqual(r, request), true)
            case None => @Expect(false, true)
        }

        let response = Array<UInt8>(600, {i => UInt8((i + 13) % 256)})
        rig.server.sendData(response)
        @Expect(rig.server.awaitSendCompletion(Duration.second * 5), true)
        @Expect(rig.status(), "ResponseSent")
        @Expect(bytesEqual(rig.notifiedPayload(), response), true)

        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.END_REQUEST], 99))
        @Expect(rig.status(), "Disconnected")

        rig.server.stop()
        @Expect(rig.status(), "Initialized")
        @Expect(
            rig.delegate.statusTrail(),
            "PoweredOn,QrEngagementReady,Connected,Started,RequestReceived,ResponseSent,Disconnected,Initialized"
        )
    }

    @TestCase
    func startRequest_resetsPartialReadBuffer(): Unit {
        let rig = LoopbackRig()
        rig.start(247)
        let stale: Array<UInt8> = [BleTransferModeConst.START_DATA, 0xEEu8, 0xEEu8]
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.CLIENT_2_SERVER_UUID, stale, 5))
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.START_REQUEST], 6))
        let fresh: Array<UInt8> = [BleTransferModeConst.END_DATA, 0x11u8]
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.CLIENT_2_SERVER_UUID, fresh, 7))
        match (rig.delegate.lastReceived) {
            case Some(r) =>
                @Expect(r.size, 1)
                @Expect(r[0], 0x11u8)
            case None => @Expect(false, true)
        }
    }

    @TestCase
    func endRequest_emitsDisconnectedOnce(): Unit {
        let rig = LoopbackRig()
        rig.start(185)
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.END_REQUEST], 3))
        @Expect(rig.status(), "Disconnected")
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.END_REQUEST], 4))
        rig.events().onConnectionStateChanged(RIG_READER_ID, false)
        @Expect(rig.delegate.statusTrail(), "PoweredOn,QrEngagementReady,Connected,Started,Disconnected")
    }

    @TestCase
    func unsubscribe_duringSession_emitsDisconnected(): Unit {
        let rig = LoopbackRig()
        rig.start(185)
        rig.events().onWriteRequest(rig.cccd(ServiceCharacteristics.SERVER_2_CLIENT_UUID, false))
        @Expect(rig.status(), "Disconnected")
    }

    @TestCase
    func linkLoss_duringSession_emitsDisconnected(): Unit {
        let rig = LoopbackRig()
        rig.start(185)
        rig.events().onConnectionStateChanged(RIG_READER_ID, false)
        @Expect(rig.status(), "Disconnected")
    }

    @TestCase
    func linkLoss_beforeSubscription_doesNotEmitDisconnected(): Unit {
        let rig = LoopbackRig()
        rig.server.startBleAdvertising()
        rig.events().onConnectionStateChanged(RIG_READER_ID, true)
        rig.events().onConnectionStateChanged(RIG_READER_ID, false)
        @Expect(rig.status(), "QrEngagementReady")
    }

    @TestCase
    func stop_tearsDownAndIsIdempotent(): Unit {
        let rig = LoopbackRig()
        rig.start(185)
        rig.server.stop()
        @Expect(rig.status(), "Initialized")
        @Expect(rig.backend.isOpen(), false)
        @Expect(rig.backend.isAdvertising(), false)
        @Expect(rig.server.isBlePoweredOn(), false)
        @Expect(rig.server.negotiatedMtuSize(), 23)
        let trailAfterFirst = rig.delegate.statusTrail()
        rig.server.stop()
        @Expect(rig.delegate.statusTrail(), trailAfterFirst)
    }

    @TestCase
    func stop_withoutStart_isSafe(): Unit {
        let rig = LoopbackRig()
        rig.server.stop()
        @Expect(rig.status(), "Initialized")
        @Expect(rig.delegate.statusTrail(), "")
    }
}

// ============================================================================
// Test class 15: MTU negotiation drives the notify block size
// ============================================================================

@Test
class GattServerMtuChunkingE2EUT {

    @TestCase
    func blockSizeFor_standardMtus(): Unit {
        @Expect(MdocGattServer.blockSizeFor(23), 19)
        @Expect(MdocGattServer.blockSizeFor(185), 181)
        @Expect(MdocGattServer.blockSizeFor(247), 243)
        @Expect(MdocGattServer.blockSizeFor(517), 511)
    }

    @TestCase
    func blockSizeFor_clampsBelowMinimumAndAboveCap(): Unit {
        @Expect(MdocGattServer.blockSizeFor(0), 19)
        @Expect(MdocGattServer.blockSizeFor(515), 511)
        @Expect(MdocGattServer.blockSizeFor(1000), 511)
    }

    @TestCase
    func defaultBlockSize_beforeNegotiation_is19(): Unit {
        let rig = LoopbackRig()
        rig.connect(23)
        @Expect(rig.server.negotiatedMtuSize(), 23)
        @Expect(rig.server.currentBlockSize(), 19)
    }

    @TestCase
    func mtuChange_belowMinimum_isIgnored(): Unit {
        let rig = LoopbackRig()
        rig.connect(247)
        rig.events().onMtuChanged(10)
        @Expect(rig.server.negotiatedMtuSize(), 247)
    }

    @TestCase
    func newLink_resetsMtuToDefault(): Unit {
        let rig = LoopbackRig()
        rig.connect(517)
        @Expect(rig.server.negotiatedMtuSize(), 517)
        rig.events().onConnectionStateChanged("AA:AA:AA:AA:AA:AA", true)
        @Expect(rig.server.negotiatedMtuSize(), 23)
    }

    /// Sends 1000 bytes at `mtu` and returns "" when every notification obeys
    /// `expectedBlock`, otherwise a description of the first deviation.
    func chunkingDeviation(mtu: Int32, expectedBlock: Int64): String {
        let rig = LoopbackRig()
        rig.start(mtu)
        if (rig.server.currentBlockSize() != expectedBlock) {
            return "currentBlockSize ${rig.server.currentBlockSize()} != ${expectedBlock}"
        }
        let payload = Array<UInt8>(1000, {i => UInt8((i * 7 + 3) % 256)})
        rig.server.sendData(payload)
        if (!rig.server.awaitSendCompletion(Duration.second * 5)) {
            return "send queue did not drain"
        }
        if (rig.status() != "ResponseSent") {
            return "status ${rig.status()} != ResponseSent"
        }
        let notified = rig.backend.notified()
        let wantBlocks = BleTransferFraming.countNumBlocks(payload.size, expectedBlock)
        if (notified.size != wantBlocks) {
            return "${notified.size} notifications != ${wantBlocks}"
        }
        var maxLen: Int64 = 0
        var i: Int64 = 0
        while (i < notified.size) {
            if (notified[i].value.size > maxLen) {
                maxLen = notified[i].value.size
            }
            if (notified[i].characteristicUuid != ServiceCharacteristics.SERVER_2_CLIENT_UUID) {
                return "block ${i} notified on ${notified[i].characteristicUuid}"
            }
            if (notified[i].deviceId != RIG_READER_ID) {
                return "block ${i} targeted ${notified[i].deviceId}"
            }
            let wantPrefix = if (i == notified.size - 1) { BleTransferModeConst.END_DATA } else { BleTransferModeConst.START_DATA }
            if (notified[i].value[0] != wantPrefix) {
                return "block ${i} prefix ${notified[i].value[0]} != ${wantPrefix}"
            }
            i++
        }
        if (maxLen != expectedBlock + 1) {
            return "largest notification ${maxLen} != ${expectedBlock + 1}"
        }
        if (!bytesEqual(rig.notifiedPayload(), payload)) {
            return "reassembled response differs from payload"
        }
        return ""
    }

    @TestCase
    func chunking_mtu23(): Unit {
        @Expect(this.chunkingDeviation(23, 19), "")
    }

    @TestCase
    func chunking_mtu185(): Unit {
        @Expect(this.chunkingDeviation(185, 181), "")
    }

    @TestCase
    func chunking_mtu247(): Unit {
        @Expect(this.chunkingDeviation(247, 243), "")
    }

    @TestCase
    func chunking_mtu517_isCappedAt511(): Unit {
        @Expect(this.chunkingDeviation(517, 511), "")
    }
}

// ============================================================================
// Test class 16: write rejection (malformed blocks, bad State bytes)
// ============================================================================

@Test
class GattServerWriteRejectionE2EUT {

    @TestCase
    func malformedPrefix_rejectedWithUnlikelyError(): Unit {
        let server = MdocGattServer()
        let bad: Array<UInt8> = [0x07u8, 0xAAu8, 0xBBu8]
        match (server.handleCharacteristicWrite(ServiceCharacteristics.CLIENT_2_SERVER_UUID, bad)) {
            case WriteOutcome.Rejected(att) => @Expect(att, AttStatus.UNLIKELY_ERROR)
            case _ => @Expect(false, true)
        }
        @Expect(statusName(server.currentStatus()), "Initialized")
    }

    @TestCase
    func malformedPrefix_doesNotPolluteReadBuffer(): Unit {
        let server = MdocGattServer()
        let bad: Array<UInt8> = [0x07u8, 0xAAu8, 0xBBu8]
        let _ = server.handleCharacteristicWrite(ServiceCharacteristics.CLIENT_2_SERVER_UUID, bad)
        let good: Array<UInt8> = [BleTransferModeConst.END_DATA, 0x01u8, 0x02u8]
        match (server.processWrittenBytes(ServiceCharacteristics.CLIENT_2_SERVER_UUID, good)) {
            case Some(p) =>
                @Expect(p.size, 2)
                @Expect(p[0], 0x01u8)
                @Expect(p[1], 0x02u8)
            case None => @Expect(false, true)
        }
    }

    @TestCase
    func malformedPrefix_attResponseCarriesError(): Unit {
        let rig = LoopbackRig()
        rig.start(247)
        let bad: Array<UInt8> = [0x07u8, 0xAAu8]
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.CLIENT_2_SERVER_UUID, bad, 42))
        let responses = rig.backend.responded()
        @Expect(responses.size > 0, true)
        let last = responses[responses.size - 1]
        @Expect(last.transId, 42)
        @Expect(last.status, AttStatus.UNLIKELY_ERROR)
        @Expect(rig.status(), "Started")
    }

    @TestCase
    func emptyClient2ServerBlock_rejected(): Unit {
        let server = MdocGattServer()
        match (server.handleCharacteristicWrite(ServiceCharacteristics.CLIENT_2_SERVER_UUID, Array<UInt8>())) {
            case WriteOutcome.Rejected(att) => @Expect(att, AttStatus.UNLIKELY_ERROR)
            case _ => @Expect(false, true)
        }
    }

    @TestCase
    func invalidStateByte_rejected(): Unit {
        let server = MdocGattServer()
        match (server.handleCharacteristicWrite(ServiceCharacteristics.STATE_UUID, [0x09u8])) {
            case WriteOutcome.Rejected(att) => @Expect(att, AttStatus.UNLIKELY_ERROR)
            case _ => @Expect(false, true)
        }
        @Expect(statusName(server.currentStatus()), "Initialized")
    }

    @TestCase
    func emptyStateWrite_rejectedRequestNotSupported(): Unit {
        let server = MdocGattServer()
        match (server.handleCharacteristicWrite(ServiceCharacteristics.STATE_UUID, Array<UInt8>())) {
            case WriteOutcome.Rejected(att) => @Expect(att, AttStatus.REQUEST_NOT_SUPPORTED)
            case _ => @Expect(false, true)
        }
    }

    @TestCase
    func unknownCharacteristic_rejectedRequestNotSupported(): Unit {
        let server = MdocGattServer()
        match (server.handleCharacteristicWrite("00000099-FFFF-FFFF-FFFF-FFFFFFFFFFFF", [0x01u8])) {
            case WriteOutcome.Rejected(att) => @Expect(att, AttStatus.REQUEST_NOT_SUPPORTED)
            case _ => @Expect(false, true)
        }
    }

    @TestCase
    func validWrites_areAccepted(): Unit {
        let server = MdocGattServer()
        match (server.handleCharacteristicWrite(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.START_REQUEST])) {
            case WriteOutcome.Accepted => ()
            case _ => @Expect(false, true)
        }
        match (server.handleCharacteristicWrite(ServiceCharacteristics.CLIENT_2_SERVER_UUID, [BleTransferModeConst.START_DATA, 0x01u8])) {
            case WriteOutcome.Accepted => ()
            case _ => @Expect(false, true)
        }
        match (server.handleCharacteristicWrite(ServiceCharacteristics.CLIENT_2_SERVER_UUID, [BleTransferModeConst.END_DATA, 0x02u8])) {
            case WriteOutcome.Completed(p) =>
                @Expect(p.size, 2)
                @Expect(p[0], 0x01u8)
                @Expect(p[1], 0x02u8)
            case _ => @Expect(false, true)
        }
    }

    @TestCase
    func uuidMatching_isCaseInsensitive(): Unit {
        let server = MdocGattServer()
        let lower = ServiceCharacteristics.STATE_UUID.toAsciiLower()
        match (server.handleCharacteristicWrite(lower, [BleTransferModeConst.START_REQUEST])) {
            case WriteOutcome.Accepted => ()
            case _ => @Expect(false, true)
        }
        @Expect(statusName(server.currentStatus()), "Started")
    }
}

// ============================================================================
// Test class 17: serial notify queue — drain, retry, give-up
// ============================================================================

@Test
class GattServerNotifyQueueE2EUT {

    @TestCase
    func sendData_emitsResponseSentAfterDrain(): Unit {
        let rig = LoopbackRig()
        rig.start(247)
        let payload = Array<UInt8>(2000, {i => UInt8(i % 256)})
        rig.server.sendData(payload)
        @Expect(rig.server.awaitSendCompletion(Duration.second * 5), true)
        @Expect(rig.status(), "ResponseSent")
        @Expect(rig.backend.notified().size, BleTransferFraming.countNumBlocks(2000, 243))
        @Expect(bytesEqual(rig.notifiedPayload(), payload), true)
    }

    @TestCase
    func sendData_empty_emitsResponseSentImmediately(): Unit {
        let rig = LoopbackRig()
        rig.start(247)
        rig.server.sendData(Array<UInt8>())
        @Expect(rig.status(), "ResponseSent")
        @Expect(rig.backend.notified().size, 0)
    }

    @TestCase
    func awaitSendCompletion_withNothingPending_returnsTrue(): Unit {
        let rig = LoopbackRig()
        @Expect(rig.server.awaitSendCompletion(Duration.millisecond * 10), true)
    }

    @TestCase
    func transientNotifyFailure_isRetried(): Unit {
        let rig = LoopbackRig()
        rig.start(517)
        rig.backend.failNextNotifies(2)
        let payload = Array<UInt8>(50, {i => UInt8(i % 256)})
        rig.server.sendData(payload)
        @Expect(rig.server.awaitSendCompletion(Duration.second * 5), true)
        @Expect(rig.status(), "ResponseSent")
        @Expect(rig.backend.notifyAttemptCount(), 3)
        @Expect(rig.backend.notified().size, 1)
        @Expect(bytesEqual(rig.notifiedPayload(), payload), true)
    }

    @TestCase
    func persistentNotifyFailure_endsInError(): Unit {
        let rig = LoopbackRig()
        rig.start(517)
        rig.backend.failNextNotifies(100)
        rig.server.sendData(Array<UInt8>(50, {i => UInt8(i % 256)}))
        @Expect(rig.server.awaitSendCompletion(Duration.second * 5), true)
        @Expect(rig.status(), "Error")
        match (rig.delegate.lastErrorCode) {
            case Some(c) => @Expect(c.describe(), "GENERIC_ERROR")
            case None => @Expect(false, true)
        }
        @Expect(rig.backend.notifyAttemptCount(), 5)
        @Expect(rig.backend.notified().size, 0)
    }

    /// Pacing with a start delay long enough for the test thread to cancel
    /// before the first chunk leaves the queue.
    func slowStartPacing(): NotifyPacing {
        return NotifyPacing(
            startDelay: Duration.millisecond * 200,
            interChunkDelay: Duration.millisecond * 5,
            retryBackoff: Duration.Zero,
            maxAttempts: 5
        )
    }

    @TestCase
    func endRequest_duringSend_cancelsWithoutResponseSent(): Unit {
        let rig = LoopbackRig(pacing: this.slowStartPacing())
        rig.start(23)
        rig.server.sendData(Array<UInt8>(4000, {i => UInt8(i % 256)}))
        rig.events().onWriteRequest(rig.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.END_REQUEST], 9))
        @Expect(rig.server.awaitSendCompletion(Duration.second * 5), true)
        @Expect(rig.status(), "Disconnected")
        @Expect(rig.delegate.statusTrail().contains("ResponseSent"), false)
    }

    @TestCase
    func stop_duringSend_settlesQueue(): Unit {
        let rig = LoopbackRig(pacing: this.slowStartPacing())
        rig.start(23)
        rig.server.sendData(Array<UInt8>(4000, {i => UInt8(i % 256)}))
        rig.server.stop()
        @Expect(rig.server.awaitSendCompletion(Duration.second * 5), true)
        @Expect(rig.status(), "Initialized")
        @Expect(rig.backend.notified().size, 0)
        @Expect(rig.delegate.statusTrail().contains("ResponseSent"), false)
    }
}

// ============================================================================
// Test class 18: radio state and Ident characteristic
// ============================================================================

@Test
class GattServerRadioAndIdentE2EUT {

    @TestCase
    func radioOff_reportsBluetoothIsOffWithoutEngagement(): Unit {
        let rig = LoopbackRig()
        rig.backend.refuseOpen(BleErrorCodes.BLUETOOTH_DISABLED)
        rig.server.startBleAdvertising()
        @Expect(rig.status(), "Error")
        match (rig.delegate.lastErrorCode) {
            case Some(c) => @Expect(c.describe(), "BLE_NOT_SUPPORTED")
            case None => @Expect(false, true)
        }
        @Expect(rig.delegate.lastErrorMessage.contains("Bluetooth is off"), true)
        @Expect(rig.delegate.poweredOnCalls, 0)
        @Expect(rig.delegate.statusTrail(), "Error")
        @Expect(rig.server.isBlePoweredOn(), false)
        @Expect(rig.backend.isAdvertising(), false)
    }

    @TestCase
    func permissionDenied_reportsBleNotAuthorized(): Unit {
        let rig = LoopbackRig()
        rig.backend.refuseOpen(BleErrorCodes.PERMISSION_DENIED)
        rig.server.startBleAdvertising()
        match (rig.delegate.lastErrorCode) {
            case Some(c) => @Expect(c.describe(), "BLE_NOT_AUTHORIZED")
            case None => @Expect(false, true)
        }
        @Expect(rig.delegate.poweredOnCalls, 0)
    }

    @TestCase
    func operationFailed_reportsUnexpectedError(): Unit {
        let rig = LoopbackRig()
        rig.backend.refuseOpen(BleErrorCodes.OPERATION_FAILED)
        rig.server.startBleAdvertising()
        match (rig.delegate.lastErrorCode) {
            case Some(c) => @Expect(c.describe(), "GENERIC_ERROR")
            case None => @Expect(false, true)
        }
        @Expect(rig.delegate.lastErrorMessage.contains("loopback open refused"), true)
        @Expect(rig.delegate.poweredOnCalls, 0)
    }

    @TestCase
    func errorState_blocksFurtherAdvertising(): Unit {
        let rig = LoopbackRig()
        rig.backend.refuseOpen(BleErrorCodes.BLUETOOTH_DISABLED)
        rig.server.startBleAdvertising()
        rig.server.startBleAdvertising()
        @Expect(rig.backend.isOpen(), false)
        @Expect(rig.delegate.statusTrail(), "Error")
    }

    @TestCase
    func isBlePoweredOn_falseBeforeAdvertising(): Unit {
        let rig = LoopbackRig()
        @Expect(rig.server.isBlePoweredOn(), false)
    }

    @TestCase
    func identValue_isRegisteredAndReadable(): Unit {
        let rig = LoopbackRig()
        let ident: Array<UInt8> = [0xDEu8, 0xADu8, 0xBEu8, 0xEFu8]
        rig.server.setIdentValue(ident)
        rig.connect(247)
        match (rig.backend.registeredIdentValue()) {
            case Some(v) => @Expect(bytesEqual(v, ident), true)
            case None => @Expect(false, true)
        }
        rig.events().onReadRequest(GattAttributeRequest(RIG_READER_ID, 77, 0, true, ServiceCharacteristics.IDENT_UUID, None, Array<UInt8>()))
        let responses = rig.backend.responded()
        let last = responses[responses.size - 1]
        @Expect(last.transId, 77)
        @Expect(last.status, AttStatus.SUCCESS)
        @Expect(bytesEqual(last.value, ident), true)
    }

    @TestCase
    func identRead_honoursOffset(): Unit {
        let rig = LoopbackRig()
        rig.server.setIdentValue([0x01u8, 0x02u8, 0x03u8])
        rig.connect(247)
        rig.events().onReadRequest(GattAttributeRequest(RIG_READER_ID, 78, 2, true, ServiceCharacteristics.IDENT_UUID, None, Array<UInt8>()))
        let responses = rig.backend.responded()
        let last = responses[responses.size - 1]
        @Expect(last.status, AttStatus.SUCCESS)
        @Expect(last.value.size, 1)
        @Expect(last.value[0], 0x03u8)
    }

    @TestCase
    func identUnset_readIsNotPermitted(): Unit {
        let rig = LoopbackRig()
        rig.connect(247)
        @Expect(rig.backend.registeredIdentValue().isNone(), true)
        rig.events().onReadRequest(GattAttributeRequest(RIG_READER_ID, 79, 0, true, ServiceCharacteristics.IDENT_UUID, None, Array<UInt8>()))
        let responses = rig.backend.responded()
        let last = responses[responses.size - 1]
        @Expect(last.status, AttStatus.READ_NOT_PERMITTED)
    }

    @TestCase
    func cccdRead_reflectsSubscriptionState(): Unit {
        let rig = LoopbackRig()
        rig.connect(247)
        rig.events().onReadRequest(GattAttributeRequest(RIG_READER_ID, 80, 0, true, ServiceCharacteristics.STATE_UUID, Some(CCCD_UUID), Array<UInt8>()))
        let responses = rig.backend.responded()
        let last = responses[responses.size - 1]
        @Expect(last.status, AttStatus.SUCCESS)
        @Expect(last.value.size, 2)
        @Expect(last.value[0], 0x01u8)
    }
}
