// ---------------------------------------------------------------------------
// Test helpers
// ---------------------------------------------------------------------------

/// Maps a TransferStatus to a stable string so it can be compared with @Expect
/// (the enum has no derived equality).
func statusName(s: TransferStatus): String {
    match (s) {
        case TransferStatus.Initializing => "Initializing"
        case TransferStatus.Initialized => "Initialized"
        case TransferStatus.PoweredOn => "PoweredOn"
        case TransferStatus.QrEngagementReady => "QrEngagementReady"
        case TransferStatus.Connected => "Connected"
        case TransferStatus.Started => "Started"
        case TransferStatus.RequestReceived => "RequestReceived"
        case TransferStatus.UserSelected => "UserSelected"
        case TransferStatus.ResponseSent => "ResponseSent"
        case TransferStatus.Disconnected => "Disconnected"
        case TransferStatus.Error => "Error"
    }
}

/// Minimal concrete MdocOfflineDelegate used to exercise get/setDelegate and the
/// delegate interface itself. Records the last callbacks it received.
class RecordingDelegate <: MdocOfflineDelegate {
    var poweredOnCalls: Int64 = 0
    var lastStatus: ?TransferStatus = None
    var lastErrorCode: ?ErrorCode = None
    var lastErrorMessage: String = ""
    var lastReceived: ?Array<UInt8> = None
    var connectedCalls: Int64 = 0
    let statuses: ArrayList<String> = ArrayList<String>()
    let engagement: ?DeviceEngagementInfo

    init(engagement: ?DeviceEngagementInfo) {
        this.engagement = engagement
    }

    public func didPoweredOn(_: Bool): Unit {
        this.poweredOnCalls += 1
    }

    public func didConnected(_: Bool, _: ?String): Unit {
        this.connectedCalls += 1
    }

    public func didChangeStatus(newStatus: TransferStatus): Unit {
        this.lastStatus = Some(newStatus)
        this.statuses.add(statusName(newStatus))
    }

    public func didReceiveRequest(data: Array<UInt8>): Unit {
        this.lastReceived = Some(data)
    }

    public func didFinishedWithError(code: ErrorCode, message: String): Unit {
        this.lastErrorCode = Some(code)
        this.lastErrorMessage = message
    }

    public func deviceEngagement(): ?DeviceEngagementInfo {
        return this.engagement
    }

    /// Comma-joined didChangeStatus history, e.g. "PoweredOn,QrEngagementReady".
    func statusTrail(): String {
        var sb = StringBuilder()
        var first = true
        for (s in this.statuses) {
            if (!first) {
                sb.append(",")
            }
            sb.append(s)
            first = false
        }
        return sb.toString()
    }
}

// ---------------------------------------------------------------------------
// Loopback rig helpers — drive MdocGattServer without a radio
// ---------------------------------------------------------------------------

let RIG_SERVICE_UUID: String = "0000A0F1-0000-1000-8000-00805F9B34FB"
let RIG_READER_ID: String = "11:22:33:AA:BB:FF"

/// A loopback holder plus the reader-side event sink to drive it.
class LoopbackRig {
    let backend: LoopbackPeripheralBackend
    let server: MdocGattServer
    let delegate: RecordingDelegate

    init(pacing!: NotifyPacing = NotifyPacing.immediate()) {
        this.backend = LoopbackPeripheralBackend()
        this.server = MdocGattServer(backend: this.backend, pacing: pacing)
        this.delegate = RecordingDelegate(Some(DeviceEngagementInfo(RIG_SERVICE_UUID)))
        this.server.setDelegate(this.delegate)
    }

    func status(): String {
        return statusName(this.server.currentStatus())
    }

    /// The event sink captured by the backend; only valid after startBleAdvertising().
    func events(): GattPeripheralEvents {
        match (this.backend.eventSink()) {
            case Some(e) => return e
            case None => throw Exception("loopback backend not opened")
        }
    }

    func cccd(charUuid: String, enable: Bool): GattAttributeRequest {
        let v: Array<UInt8> = if (enable) { [0x01u8, 0x00u8] } else { [0x00u8, 0x00u8] }
        return GattAttributeRequest(RIG_READER_ID, 1, 0, true, charUuid, Some(CCCD_UUID), v)
    }

    func write(charUuid: String, value: Array<UInt8>, transId: Int32): GattAttributeRequest {
        return GattAttributeRequest(RIG_READER_ID, transId, 0, true, charUuid, None, value)
    }

    /// startBleAdvertising + link up + MTU + both CCCD subscriptions (→ Connected).
    func connect(mtu: Int32): Unit {
        this.server.startBleAdvertising()
        let ev = this.events()
        ev.onConnectionStateChanged(RIG_READER_ID, true)
        ev.onMtuChanged(mtu)
        ev.onWriteRequest(this.cccd(ServiceCharacteristics.STATE_UUID, true))
        ev.onWriteRequest(this.cccd(ServiceCharacteristics.SERVER_2_CLIENT_UUID, true))
    }

    /// connect() followed by START_REQUEST (→ Started).
    func start(mtu: Int32): Unit {
        this.connect(mtu)
        this.events().onWriteRequest(this.write(ServiceCharacteristics.STATE_UUID, [BleTransferModeConst.START_REQUEST], 2))
    }

    /// Feed a full request through Client2Server in `fragment`-byte blocks.
    func writeRequest(payload: Array<UInt8>, fragment: Int64): Unit {
        let blocks = BleTransferFraming.prepareDataBlocksToSend(payload, fragment)
        var i: Int64 = 0
        while (i < blocks.size) {
            this.events().onWriteRequest(this.write(ServiceCharacteristics.CLIENT_2_SERVER_UUID, blocks[i], Int32(10 + i)))
            i++
        }
    }

    /// Everything the holder notified on Server2Client, reassembled.
    func notifiedPayload(): Array<UInt8> {
        let notified = this.backend.notified()
        let blocks = Array<Array<UInt8>>(notified.size, {i => notified[i].value})
        return BleTransferFraming.reassemble(blocks)
    }
}

func bytesEqual(a: Array<UInt8>, b: Array<UInt8>): Bool {
    if (a.size != b.size) {
        return false
    }
    var i: Int64 = 0
    while (i < a.size) {
        if (a[i] != b[i]) {
            return false
        }
        i++
    }
    return true
}

// ============================================================================
// Test class 8: OrchestratorError
// ============================================================================

@Test
class OrchestratorErrorE2EUT {

    @TestCase
    func construct_codeAndMessage(): Unit {
        let err = OrchestratorError("REQUEST_DECODE_ERROR", "bad cbor")
        @Expect(err.code, "REQUEST_DECODE_ERROR")
        @Expect(err.message, "bad cbor")
    }

    @TestCase
    func construct_emptyMessage(): Unit {
        let err = OrchestratorError("GENERIC", "")
        @Expect(err.code, "GENERIC")
        @Expect(err.message, "")
    }

    @TestCase
    func isCatchableAsException(): Unit {
        var caughtCode = ""
        var caughtMsg = ""
        try {
            throw OrchestratorError("DECRYPT_FAIL", "tag mismatch")
        } catch (e: OrchestratorError) {
            caughtCode = e.code
            caughtMsg = e.message
        }
        @Expect(caughtCode, "DECRYPT_FAIL")
        @Expect(caughtMsg, "tag mismatch")
    }

    @TestCase
    func isCatchableAsBaseException(): Unit {
        var caught = false
        try {
            throw OrchestratorError("X", "y")
        } catch (e: Exception) {
            caught = true
        }
        @Expect(caught, true)
    }
}

// ============================================================================
