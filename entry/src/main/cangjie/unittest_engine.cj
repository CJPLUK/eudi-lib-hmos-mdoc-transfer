/*
 * unittest_engine.cj — OpenHarmonyTestRunner (GENERATED by gen_ut.py; infra only,
 * NO test cases here). Reads TestReport for real pass/fail; ResultCode = 0 only
 * when failed+error == 0. Test cases live in the sibling *_suite.cj / test_cases.cj.
 */
package ohos_app_cangjie_entry

import std.unittest.*
import std.unittest.testmacro.*
import std.collection.*
import kit.PerformanceAnalysisKit.Hilog
import kit.TestKit.AbilityDelegatorRegistry
import kit.TestKit.TestRunner
import kit.AbilityKit.BundleManager
import kit.AbilityKit.BundleFlag
import kit.AbilityKit.Want

// Back-compat: some *_suite.cj expose register*Tests() that call reg(); kept so
// they still compile. onPrepare below registers classes directly (auto-listed).
public func reg(gen: () -> TestClass): Unit {
    OpenHarmonyTestRunner.testClassInstanceGenerators.add(gen)
}

public class OpenHarmonyTestRunner <: TestRunner {
    public static let testSuiteMap = HashMap<String, TestSuite>()
    public static let testClassInstanceGenerators = ArrayList<() -> TestClass>()

    private static func getDetailedInfoOf(e: Exception): String {
        "exception: ${e.toString()}"
    }

    private func executeTestClass(testClassName: String): (Int64, Int64, Int64) {
        let d = AbilityDelegatorRegistry.getAbilityDelegator()
        Hilog.info(0, "Cangjie-Test", "EXECUTE_CLASS_START: \"${testClassName}\"")
        d.print("EXECUTE_CLASS_START: \"${testClassName}\"")
        let testSuite = match (OpenHarmonyTestRunner.testSuiteMap.get(testClassName)) {
            case None => return (0, 0, 0)
            case Some(ts) => ts
        }
        var p: Int64 = 0
        var f: Int64 = 0
        var e: Int64 = 0
        try {
            let report = testSuite.runTests()
            p = report.passedCount
            f = report.failedCount
            e = report.errorCount
        } catch (ex: Exception) {
            Hilog.error(1, "Cangjie-Test", "SUITE_EXCEPTION ${testClassName}: ${ex.message}")
            e = 1
        }
        d.print("CASE_RESULT ${testClassName}: passed=${p} failed=${f}")
        Hilog.info(0, "Cangjie-Test", "EXECUTE_CLASS_END: \"${testClassName}\"")
        d.print("EXECUTE_CLASS_END: \"${testClassName}\"")
        return (p, f, e)
    }

    private func executeAllTestClasses(): (Int64, Int64, Int64) {
        var tp: Int64 = 0
        var tf: Int64 = 0
        var te: Int64 = 0
        for (name in OpenHarmonyTestRunner.testSuiteMap.keys()) {
            let (p, f, e) = executeTestClass(name)
            tp = tp + p; tf = tf + f; te = te + e
        }
        return (tp, tf, te)
    }

    public override func onPrepare(): Unit {
        Hilog.info(0, "Cangjie-Test", "OpenHarmonyTestRunner onPrepare")
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => BleLoopbackE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => ConstantsE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => DelegateAndStatusE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => DemoIntegrationE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => DeviceEngagementInfoE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => ErrorCodeDescribeE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => FramingE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => GattClientReassemblyE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => GattServerStateMachineE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => OfflineDelegateImplE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => OrchestratorErrorE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => ReaderAuthResultE2EUT() })
        OpenHarmonyTestRunner.testClassInstanceGenerators.add({ => ValueTypesE2EUT() })
        for (gen in OpenHarmonyTestRunner.testClassInstanceGenerators) {
            let inst = try {
                gen()
            } catch (e: Exception) {
                Hilog.error(1, "Cangjie-Test", "gen exception: ${OpenHarmonyTestRunner.getDetailedInfoOf(e)}")
                continue
            }
            let suite = inst.asTestSuite()
            OpenHarmonyTestRunner.testSuiteMap.add(suite.name, suite)
        }
    }

    public override func onRun(): Unit {
        Hilog.info(0, "Cangjie-Test", "OpenHarmonyTestRunner onRun")
        let args = AbilityDelegatorRegistry.getArguments()
        let d = AbilityDelegatorRegistry.getAbilityDelegator()
        let bundleName = args.bundleName
        let bundleInfo = BundleManager.getBundleInfoForSelf(
            BundleFlag.GET_BUNDLE_INFO_WITH_HAP_MODULE | BundleFlag.GET_BUNDLE_INFO_WITH_APPLICATION)
        let moduleName = match (args.parameters.get("-m")) {
            case None =>
                d.finishTest("Module name was not specified.", -1)
                return
            case Some(mn) => mn
        }
        d.startAbility(Want(bundleName: bundleName, moduleName: moduleName, abilityName: "EntryAbility"))
        spawn {
            var tp: Int64 = 0
            var tf: Int64 = 0
            var te: Int64 = 0
            try {
                let (p, f, e) = executeAllTestClasses()
                tp = p; tf = f; te = e
            } catch (e: Exception) {
                Hilog.error(1, "Cangjie-Test", "run exception: ${OpenHarmonyTestRunner.getDetailedInfoOf(e)}")
                te = te + 1
            }
            let summary = "passed=${tp} failed=${tf} error=${te}"
            let rc = if (tf + te == 0) { 0 } else { -1 }
            Hilog.info(0, "Cangjie-Test", "TEST_SUMMARY: ${summary} ResultCode=${rc}")
            d.print("TEST_SUMMARY: ${summary}")
            d.finishTest(summary, rc)
        }
    }
}

let _ = TestRunner.registerCreator("OpenHarmonyTestRunner") { OpenHarmonyTestRunner() }
